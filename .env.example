# ProfitPulse environment template.
# Copy to .env (or run `python scripts/init_env.py`, which fills every CHANGE_ME
# with a random secret). .env is git-ignored. Never commit real values.

COMPOSE_PROJECT_NAME=profitpulse

# ---- Host ports (bound to 127.0.0.1 only) ---------------------------------
# Chosen after checking occupied ports on the dev machine. Container-internal
# ports stay standard (5432, 8080, 8000); Kafka's host listener is 19092.
PP_POSTGRES_HOST_PORT=15432
PP_KAFKA_HOST_PORT=19092
PP_AIRFLOW_HOST_PORT=18080
PP_WEB_HOST_PORT=18000

# ---- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=profitpulse
POSTGRES_USER=pp_admin
POSTGRES_PASSWORD=CHANGE_ME
# Pipeline role: owns the analytical schemas (used by Spark/Airflow tasks).
PP_APP_USER=pp_app
PP_APP_PASSWORD=CHANGE_ME
# Read-only role used by the web UI and BI tools.
PP_READER_USER=pp_reader
PP_READER_PASSWORD=CHANGE_ME
# Airflow metadata database (same server, separate database).
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME

# ---- Airflow --------------------------------------------------------------
AIRFLOW_FERNET_KEY=CHANGE_ME
AIRFLOW_JWT_SECRET=CHANGE_ME
AIRFLOW_API_SECRET_KEY=CHANGE_ME
AIRFLOW_UID=50000

# ---- Kafka ----------------------------------------------------------------
KAFKA_CLUSTER_ID=CHANGE_ME_UUID
KAFKA_TOPIC_PREFIX=pp

# ---- Spark ----------------------------------------------------------------
# local[*] for the single-node setup; set to spark://host:7077 on a cluster.
SPARK_MASTER=local[4]
SPARK_DRIVER_MEMORY=3g

# ---- Business settings ----------------------------------------------------
PP_CURRENCY=PKR
